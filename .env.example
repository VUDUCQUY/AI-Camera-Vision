# Sao chép thành .env rồi sửa. File .env KHÔNG được commit (đã có trong .gitignore).

# Đăng nhập cho toàn bộ web + API (bỏ trống = không cần đăng nhập, chỉ nên dùng trong mạng nội bộ)
WMS_BASIC_AUTH=admin:doi-mat-khau-nay

# Giới hạn dung lượng mỗi file upload (MB)
WMS_MAX_UPLOAD_MB=1024

# Video upload cũ hơn N giờ sẽ bị tự xoá
WMS_UPLOAD_TTL_HOURS=6

# Chỉ cần khi frontend chạy ở domain KHÁC backend (mặc định backend phục vụ luôn frontend → cùng origin)
# WMS_CORS_ORIGINS=https://kho.example.com

# Google Sheets (bỏ trống / thiếu file → vẫn chạy, chỉ tắt đồng bộ)
WMS_SHEET_NAME=WMS_Pallet
# WMS_GOOGLE_CREDS=/duong/dan/service-account.json

# Model YOLO (mặc định weights/best_v2.pt; model gốc: weights/best_v1_original.pt)
# WMS_YOLO_WEIGHTS=/app/weights/best_v1_original.pt
